// Konfigurasi untuk deploy sebagai Cloudflare WORKERS.
// Jika kamu memakai Cloudflare PAGES, file ini otomatis dilewati (aman dibiarkan).
{
  "name": "ai-video-remotion",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
